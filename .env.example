# Copier ce fichier en .env.local et renseigner les valeurs réelles.
# .env.local n'est jamais commité (voir .gitignore : .env*.local).

# ==============================================================================
# 1. SUPABASE (base de données et authentification)
# Format attendu : https://<ref-projet>.supabase.co
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : jamais préfixée NEXT_PUBLIC_, jamais importée dans un
# composant client. Réservée aux Server Actions / Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 2. IA (reformulation juridique assistée — src/app/api/ai/reformuler)
# Fonctionnalité sous feature flag : désactivée par défaut, repli sur un
# texte générique tant que AI_ENABLED n'est pas "true" et qu'une clé valide
# n'est pas fournie. Utilise l'API DeepSeek (compatible OpenAI, modèle
# "deepseek-chat").
# ==============================================================================
AI_ENABLED=false
DEEPSEEK_API_KEY=

# ==============================================================================
# 3. MODE DÉMONSTRATION HORS-LIGNE (développement local uniquement)
# Verrouillé en production quel que soit son contenu (voir
# src/lib/constants/mode.ts). Ne jamais activer sur un déploiement réel.
# ==============================================================================
NEXT_PUBLIC_OFFLINE_SEED=false

# ==============================================================================
# 4. COMPTE DE TEST E2E (Playwright, tests/e2e/)
# Compte dédié aux tests, distinct de tout compte réel de délégué. Sans ces
# variables, les parcours authentifiés de tests/e2e/questionnaire.test.ts
# sont ignorés plutôt que simulés de façon peu sûre.
# ==============================================================================
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
