# Copier ce fichier en .env.local et renseigner les valeurs réelles.
# .env.local n'est jamais commité (voir .gitignore : .env*.local).
#
# ⚠️ Next.js ne recharge PAS .env.local à chaud : après toute modification
# de ce fichier, arrêtez puis relancez `pnpm dev` (ou le serveur de prod).

# ==============================================================================
# 1. SUPABASE (base de données)
# Format attendu : https://<ref-projet>.supabase.co
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : jamais préfixée NEXT_PUBLIC_, jamais importée dans un
# composant client. Utilisée exclusivement par src/lib/supabase/admin.ts,
# pour toutes les écritures (participants, reponses, propositions, decisions)
# et les lectures qui ne sont plus accessibles à la clé anon.
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 2. SESSION PARTICIPANT (remplace Supabase Auth — voir src/lib/session.ts)
# Aucun compte, aucun mot de passe : un cookie signé HMAC-SHA256 identifie
# le participant. SESSION_SECRET doit faire au moins 32 caractères aléatoires
# (ex. `openssl rand -base64 32`). Le changer invalide toutes les sessions
# en cours (tout le monde repasse par /rejoindre).
# ==============================================================================
SESSION_SECRET=

# ==============================================================================
# 3. CODES D'ÉLÉVATION SCRIBE / BEN (route /staff)
# Deux codes à 6 chiffres, distincts, communiqués uniquement au scribe désigné
# et aux membres du BEN pour la séance. Limité à 5 tentatives / 10 min.
# ==============================================================================
STAFF_PIN_SCRIBE=
STAFF_PIN_BEN=

# ==============================================================================
# 4. URL PUBLIQUE DU SITE (liens de diffusion /ben/liens, QR codes)
# ==============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# 5. IA (reformulation juridique assistée — src/app/api/ai/reformuler)
# Fonctionnalité sous feature flag : désactivée par défaut, repli sur un
# texte générique tant que AI_ENABLED n'est pas "true" et qu'une clé valide
# n'est pas fournie. Utilise l'API DeepSeek (compatible OpenAI, modèle
# "deepseek-chat").
# ==============================================================================
AI_ENABLED=false
DEEPSEEK_API_KEY=
